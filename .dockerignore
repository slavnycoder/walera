# Keep the build context minimal: only cmd/, internal/, go.mod, go.sum
# need to enter the build stage. Everything else (docs, tests, compose
# files, Makefile, build artefacts) is intentionally excluded.

.git/
.gitignore
.gitattributes

# Tests — the production binary doesn't need them.
test/
testbin/

# Documentation — image stays minimal.
*.md
README.md
Makefile

# Compose files are operator-side.
docker-compose*.yml
docker-compose*.yaml

# Build artefacts and coverage reports.
cdc-sse
coverage.out
coverage.html

# Editor / IDE noise.
.idea/
.vscode/
*.swp
*.swo
